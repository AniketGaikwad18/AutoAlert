# AutoAlert Environment Configuration Example
# Copy this file to .env and adjust values as needed.

AUTOALERT_ENV=development
AUTOALERT_LOG_LEVEL=INFO

# Storage paths
AUTOALERT_DATA_DIR=data
AUTOALERT_OUTPUTS_DIR=outputs
AUTOALERT_MODELS_DIR=models

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./outputs/autoalert.db

# Edge / Camera Configuration
DEFAULT_CAMERA_ID=CAM-01
CAMERA_SOURCE=0

# Detection & Model Config
YOLO_MODEL_PATH=models/detection/yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
TRACKING_MAX_AGE=30

# Emergency Service Simulation
SIMULATION_MODE=true
